 			  grub_uint8_t * dst, grub_size_t blocksize,
 			  grub_size_t blocknumbers);
 
+/*
+ * Duplicate all string pointers in the keyslot, digest, and segment structs
+ * so that json_header can be freed before the large Argon2 allocation.
+ * Returns GRUB_ERR_NONE on success, error otherwise.  On error, no
+ * partial allocations are left behind and the struct pointers still
+ * reference the original json_header buffer.
+ */
+static grub_err_t
+luks2_strdup_fields (grub_luks2_keyslot_t *k, grub_luks2_digest_t *d,
+		     grub_luks2_segment_t *s)
+{
+  char *k_ae = NULL, *k_afh = NULL, *k_salt = NULL, *k_pbh = NULL;
+  char *d_salt = NULL, *d_dig = NULL, *d_hash = NULL;
+  char *s_size = NULL, *s_enc = NULL;
+
+  k_ae   = grub_strdup (k->area.encryption);
+  k_afh  = grub_strdup (k->af.hash);
+  k_salt = grub_strdup (k->kdf.salt);
+  if (k->kdf.type == LUKS2_KDF_TYPE_PBKDF2)
+    k_pbh = grub_strdup (k->kdf.u.pbkdf2.hash);
+  d_salt = grub_strdup (d->salt);
+  d_dig  = grub_strdup (d->digest);
+  d_hash = grub_strdup (d->hash);
+  s_size = grub_strdup (s->size);
+  s_enc  = grub_strdup (s->encryption);
+
+  if (!k_ae || !k_afh || !k_salt || !d_salt || !d_dig || !d_hash
+      || !s_size || !s_enc
+      || (k->kdf.type == LUKS2_KDF_TYPE_PBKDF2 && !k_pbh))
+    {
+      grub_free (k_ae);
+      grub_free (k_afh);
+      grub_free (k_salt);
+      grub_free (k_pbh);
+      grub_free (d_salt);
+      grub_free (d_dig);
+      grub_free (d_hash);
+      grub_free (s_size);
+      grub_free (s_enc);
+      return grub_error (GRUB_ERR_OUT_OF_MEMORY,
+			 "out of memory duplicating LUKS2 metadata");
+    }
+
+  k->area.encryption = k_ae;
+  k->af.hash         = k_afh;
+  k->kdf.salt        = k_salt;
+  if (k->kdf.type == LUKS2_KDF_TYPE_PBKDF2)
+    k->kdf.u.pbkdf2.hash = k_pbh;
+  d->salt   = d_salt;
+  d->digest = d_dig;
+  d->hash   = d_hash;
+  s->size       = s_size;
+  s->encryption = s_enc;
+
+  return GRUB_ERR_NONE;
+}
+
+static void
+luks2_free_fields (grub_luks2_keyslot_t *k, grub_luks2_digest_t *d,
+		   grub_luks2_segment_t *s)
+{
+  grub_free ((void *) k->area.encryption);
+  grub_free ((void *) k->af.hash);
+  grub_free ((void *) k->kdf.salt);
+  if (k->kdf.type == LUKS2_KDF_TYPE_PBKDF2)
+    grub_free ((void *) k->kdf.u.pbkdf2.hash);
+  grub_free ((void *) d->salt);
+  grub_free ((void *) d->digest);
+  grub_free ((void *) d->hash);
+  grub_free ((void *) s->size);
+  grub_free ((void *) s->encryption);
+}
